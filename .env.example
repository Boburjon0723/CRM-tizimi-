# Vercel da Project Settings > Environment Variables ga qo'shing
#
# Lokal: npm run dev → http://localhost:4000 (package.json da PORT=4000)
#
# Supabase (majburiy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Ixtiyoriy: serverda to‘liq ruxsat (stale-orders cron uchun tavsiya)
# SUPABASE_SERVICE_ROLE_KEY=

# Telegram xabarlar (yangi buyurtma + 12 kunlik ogohlantirish)
# Server uchun (tavsiya):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Yoki eski usul (brauzerga ham ochiq — kamroq xavfsiz):
# NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
# NEXT_PUBLIC_TELEGRAM_CHAT_ID=

# Groq AI (server-only) — https://console.groq.com
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# Cron himoyasi (Vercel Cron / qo‘lda chaqirish)
# CRON_SECRET=uzun-random-string

# PWA / service worker (ixtiyoriy). true bo‘lmasa prod da SW yo‘q — deploy yangilanishi tez ko‘rinadi.
# NEXT_PUBLIC_ENABLE_PWA=true
